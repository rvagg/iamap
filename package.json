{
  "name": "iamap",
  "version": "5.1.9",
  "description": "An **I**mmutable **A**synchronous **Map**.",
  "type": "module",
  "main": "iamap.js",
  "types": "./types/iamap.d.ts",
  "exports": {
    ".": {
      "import": "./iamap.js",
      "types": "./types/iamap.d.ts"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "standard *.js test/*.js",
    "build": "npm run docs && npm run build:types",
    "build:types": "tsc --build",
    "test:node": "mocha test/*-test.js",
    "test:browser": "polendina --page --worker --serviceworker --cleanup test/*-test.js",
    "test": "npm run lint && npm run build:types && npm run test:node && npm run test:browser",
    "docs": "jsdoc4readme --readme iamap.js"
  },
  "author": "Rod <rod@vagg.org> (http://r.va.gg/)",
  "license": "Apache-2.0",
  "dependencies": {
    "bit-sequence": "^1.2.0"
  },
  "devDependencies": {
    "@rvagg/chai-as-promised": "^8.0.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "chai": "^6.2.2",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "jsdoc4readme": "^1.4.0",
    "mocha": "^11.7.5",
    "murmurhash3js-revisited": "^3.0.0",
    "polendina": "^3.2.20",
    "semantic-release": "^25.0.3",
    "standard": "^17.1.2",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/rvagg/iamap.git"
  },
  "typesVersions": {
    "*": {
      "*": [
        "types/*"
      ],
      "types/*": [
        "types/*"
      ]
    }
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits",
          "releaseRules": [
            {
              "breaking": true,
              "release": "major"
            },
            {
              "revert": true,
              "release": "patch"
            },
            {
              "type": "feat",
              "release": "minor"
            },
            {
              "type": "fix",
              "release": "patch"
            },
            {
              "type": "chore",
              "release": "patch"
            },
            {
              "type": "docs",
              "release": "patch"
            },
            {
              "type": "test",
              "release": "patch"
            },
            {
              "scope": "no-release",
              "release": false
            }
          ]
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits",
          "presetConfig": {
            "types": [
              {
                "type": "feat",
                "section": "Features"
              },
              {
                "type": "fix",
                "section": "Bug Fixes"
              },
              {
                "type": "perf",
                "section": "Performance Improvements"
              },
              {
                "type": "revert",
                "section": "Reverts"
              },
              {
                "type": "refactor",
                "section": "Code Refactoring"
              },
              {
                "type": "test",
                "section": "Tests"
              },
              {
                "type": "build",
                "section": "Trivial Changes"
              },
              {
                "type": "ci",
                "section": "Trivial Changes"
              },
              {
                "type": "chore",
                "section": "Trivial Changes"
              },
              {
                "type": "docs",
                "section": "Trivial Changes"
              },
              {
                "type": "style",
                "section": "Trivial Changes"
              }
            ]
          }
        }
      ],
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/github",
      "@semantic-release/git"
    ]
  }
}
